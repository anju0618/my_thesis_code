# このファイルを .env にコピーして値を埋める（.env はgit管理対象外）
#
# Google Cloud Console (https://console.cloud.google.com/) で
#   1. 新規プロジェクトを作成（または既存プロジェクトを選択）
#   2. 「APIとサービス」→「ライブラリ」で "YouTube Data API v3" を有効化
#   3. 「APIとサービス」→「認証情報」→「認証情報を作成」→「APIキー」
# で取得したキーを貼り付ける。
YOUTUBE_API_KEY=

# Ollamaで使うモデル名（事前に `ollama pull <モデル名>` が必要）
# 未設定時は src/label_ollama.py のデフォルト値 (qwen2.5:7b-instruct) が使われる
OLLAMA_MODEL=qwen2.5:7b-instruct
